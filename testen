#!/usr/bin/env python3
"""Mini-CI: testet nur, was die Änderungen betreffen. Läuft als pre-commit-Hook (./testen) und pre-push-Hook (--push).

  ./testen              Änderungen gegen HEAD (Index, Arbeitsverzeichnis, neue Dateien)
  ./testen --seit REF   Änderungen seit REF (z. B. origin/main)
  ./testen --voll       alles: ./pruefen, alle Einzeltests, alle Teile von tests/test_gitlab.py, die UI-Tests
                        (tests/test_ui.py, echter Browser – nur hier, also im pre-push, nie im pre-commit)
  ./testen --liste      nur zeigen, was laufen würde
  ./testen --push       pre-push (Zeilen von git auf stdin): jeder gepushte Commit, dessen Baum noch nicht voll getestet
                        ist, läuft --voll, und zwar genau dieser Stand (in einem Temp-Worktree, wenn er nicht der saubere
                        Arbeitsstand ist). Auch `git push . claude:reviewed` („fertig“) und `git push origin reviewed:main`.

Takt im pre-commit (./testen ohne Argumente): der erste Commit des Tages läuft --voll, danach erst wieder, wenn seit dem
letzten vollen Lauf TAKT_STUNDEN vergangen und TAKT_COMMITS Commits durch sind (was später eintrifft) – damit
Regressionen auch zwischen zwei Pushes auffallen. Stand in .git/merge-train-takt (Zeit des letzten vollen Laufs, Commits seither).

Merkzettel: Ein grünes --voll auf einem sauberen Stand (im pre-commit: der Index, wenn das Arbeitsverzeichnis ihm
gleicht) trägt dessen Baum (Tree-ID) in .git/merge-train-getestet ein;
derselbe Inhalt gilt dann als getestet, egal unter welchem Commit oder Branch.

Auswahl:
  • web/*.js|css, web.py, pruefen, biome.json, werkzeug/  → ./pruefen
  • Python in src/                → Bau nach tests/bau/ und Import aller Module (Smoke)
                                    + die Klassen von tests/test_einheiten.py, deren Module (samt allem, was diese aus
                                      src/ importieren) sich geändert haben – automatisch aus den Imports ermittelt
                                    + die Teile von tests/test_gitlab.py laut MODUL_TEILE (unbekanntes Modul: alle)
  • tests/…                       → die geänderte Testdatei ganz (tests/test_ui.py: nichts, läuft nur mit --voll)
  • docs/, *.md, skill/ …         → nichts
  • alles andere                  → --voll
Ausgabe nur bei Fehlern ausführlich, sonst eine Zeile je Schritt. Exit 1 beim ersten Fehler.
"""
import ast, os, subprocess, sys, tempfile, time

HIER = os.path.dirname(os.path.realpath(__file__))
SRC = os.path.join(HIER, "src", "merge_train")
TESTS = os.path.join(HIER, "tests")

# Modul in src/merge_train → Teile von tests/test_gitlab.py, die es von außen (Server, CLI) prüfen.
# [] = Einzeltests genügen. Teile setzen ggf. andere voraus (TEILE in test_gitlab.py).
MODUL_TEILE = {
    "__init__": ["lokal"], "__main__": ["lokal"],
    "abhaken": ["lokal"], "agent_cli": ["gitlab", "lokal", "arbeitsstand"], "akte": [], "ansichten": ["lokal"],
    "beobachter": ["lokal"], "cli": ["lokal", "gitlab"], "diff_html": ["lokal"], "einstellungen": ["lokal", "gitlab"],
    "gespraech": ["lokal", "arbeitsstand", "gitlab"], "git": ["lokal", "arbeitsstand"], "gitlab": ["gitlab", "gemischt"],
    "hinweise": ["gitlab"], "instanz": [], "prozess": ["lokal"], "quellen": ["lokal", "arbeitsstand", "gemischt"],
    "review": ["gitlab"], "seite": ["lokal", "gitlab", "gemischt"], "server": ["lokal", "gitlab"], "syntax": ["lokal"],
    "waggon": ["lokal", "gitlab"], "web": [], "zeilen": [], "zuhoerer": ["lokal", "horchen"],
}
ALLE_TEILE = ["gitlab", "lokal", "horchen", "arbeitsstand", "gemischt"]
NICHTS = ("docs/", "skill/", "completions/", "perf/", "README.md", "AGENTS.md", "CLAUDE.md", "refactor.md", ".gitignore",
          "config.example.toml")


def git(*a):
    return subprocess.run(["git", "-C", HIER, *a], capture_output=True, text=True).stdout.split("\n")


def geaendert(seit):
    pfade = git("diff", "--name-only", seit) + git("ls-files", "--others", "--exclude-standard")
    return sorted({p for p in pfade if p})


def importe(baum, paket_namen):
    """Namen → Modul aus `from merge_train.x import …`, `from merge_train import x`, `from .x import …`, `from . import x`."""
    namen = {}
    for k in ast.walk(baum):
        if isinstance(k, ast.ImportFrom):
            mod = k.module or ""
            if mod.startswith("merge_train."):
                mod = mod[len("merge_train."):]
            elif mod == "merge_train" or (k.level and not mod):
                mod = ""
            elif not k.level:
                continue
            for a in k.names:
                ziel = mod or a.name
                if ziel in paket_namen:
                    namen[a.asname or a.name] = ziel
    return namen


def modul_graph():
    """Modul → alle Module, die es (auch über andere) aus src/ importiert, sich selbst eingeschlossen."""
    module = {f[:-3] for f in os.listdir(SRC) if f.endswith(".py")} | {"__main__"}
    direkt = {}
    for m in module:
        pfad = os.path.join(SRC, m + ".py") if m != "__main__" else os.path.join(HIER, "src", "__main__.py")
        direkt[m] = set(importe(ast.parse(open(pfad, encoding="utf-8").read()), module).values()) if os.path.exists(pfad) else set()
    huelle = {}
    for m in module:
        gesehen, offen = set(), [m]
        while offen:
            x = offen.pop()
            if x not in gesehen:
                gesehen.add(x); offen += direkt.get(x, ())
        huelle[m] = gesehen
    return module, huelle


def einheiten_klassen(module, huelle):
    """Testklasse → Module aus src/, die sie (über Hilfsfunktionen der Testdatei und Imports in src/) erreicht."""
    baum = ast.parse(open(os.path.join(TESTS, "test_einheiten.py"), encoding="utf-8").read())
    namen = importe(baum, module)
    oben = {k.name: k for k in baum.body if isinstance(k, (ast.FunctionDef, ast.ClassDef))}
    for k in baum.body:  # globale Werte wie DIFF = zerlegen(…) zählen mit
        if isinstance(k, ast.Assign):
            for z in k.targets:
                for n in ast.walk(z):
                    if isinstance(n, ast.Name):
                        oben.setdefault(n.id, k)

    def direkt(knoten):
        mods, hilfen = set(), set()
        for k in ast.walk(knoten):
            n = k.id if isinstance(k, ast.Name) else None
            if n in namen:
                mods.add(namen[n])
            elif n in oben and oben[n] is not knoten:
                hilfen.add(n)
        return mods, hilfen

    def erreicht(name, gesehen):
        mods, hilfen = direkt(oben[name])
        for h in hilfen - gesehen:
            mods |= erreicht(h, gesehen | {h})
        return mods

    klassen = {}
    for name, k in oben.items():
        if isinstance(k, ast.ClassDef) and any(isinstance(b, ast.Attribute) and b.attr == "TestCase" for b in k.bases):
            klassen[name] = set().union(*(huelle.get(m, {m}) for m in erreicht(name, {name}))) if erreicht(name, {name}) else None
    return klassen


def auswahl(pfade, voll):
    """(pruefen?, smoke?, Einzeltest-Klassen oder 'alle', Teile, Gründe)."""
    module, huelle = modul_graph()
    if voll:
        return True, True, "alle", list(ALLE_TEILE), ["--voll"]
    pruefen = smoke = False
    geaenderte_module, klassen_alle, teile, gruende = set(), False, set(), []
    for p in pfade:
        if p.startswith(NICHTS) or (p.endswith(".md") and "/" not in p):
            continue
        if p.startswith("src/merge_train/web/") or p in ("pruefen", "biome.json") or p.startswith("werkzeug/"):
            pruefen = True
            continue
        if p.startswith("src/") and p.endswith(".py"):
            smoke = True
            m = os.path.basename(p)[:-3]
            geaenderte_module.add(m)
            if m == "web":
                pruefen = True
            if m in MODUL_TEILE:
                teile |= set(MODUL_TEILE[m])
            else:
                teile |= set(ALLE_TEILE); gruende.append(f"{m}.py fehlt in MODUL_TEILE (./testen) → alle Teile")
            continue
        if p == "tests/test_einheiten.py":
            smoke = klassen_alle = True
            continue
        if p == "tests/test_ui.py":
            continue  # nur mit --voll (pre-push)
        if p in ("tests/test_gitlab.py", "tests/fake-glab", "bauen"):
            smoke = True; teile |= set(ALLE_TEILE)
            continue
        if p == "testen":
            smoke = pruefen = klassen_alle = True
            continue
        if p.endswith(".idem.sh"):
            continue  # nur sh -n, siehe main
        gruende.append(f"{p}: unbekannt → --voll")
        return True, True, "alle", list(ALLE_TEILE), gruende
    if klassen_alle:
        klassen = "alle"
    else:
        alle = einheiten_klassen(module, huelle)
        klassen = sorted(k for k, mods in alle.items() if mods is None or mods & geaenderte_module) if geaenderte_module else []
        if len(klassen) == len(alle):
            klassen = "alle"
    return pruefen, smoke, klassen, [t for t in ALLE_TEILE if t in teile], gruende


def merkzettel():
    return os.path.join(HIER, git("rev-parse", "--git-common-dir")[0], "merge-train-getestet")


def getestet():
    try:
        return set(open(merkzettel()).read().split())
    except OSError:
        return set()


def eintragen(baum):
    alte = [z for z in (open(merkzettel()).read().split() if os.path.exists(merkzettel()) else []) if z != baum]
    open(merkzettel(), "w").write("\n".join((alte + [baum])[-200:]) + "\n")


TAKT_STUNDEN, TAKT_COMMITS = 2, 5
TAKT_VOLL = False  # main: dieser pre-commit lief nach Takt voll


def takt_datei():
    return os.path.join(HIER, git("rev-parse", "--git-common-dir")[0], "merge-train-takt")


def takt_lesen():
    """(Zeit des letzten vollen Laufs oder None, Commits seither)."""
    try:
        zeit, n = open(takt_datei()).read().split()
        return float(zeit), int(n)
    except (OSError, ValueError):
        return None, 0


def voll_faellig():
    """pre-commit: Grund für einen vollen Lauf, sonst None (siehe „Takt“ oben)."""
    zeit, n = takt_lesen()
    if zeit is None or time.localtime(zeit)[:3] != time.localtime()[:3]:
        return "erster Commit des Tages"
    stunden = (time.time() - zeit) / 3600
    if stunden >= TAKT_STUNDEN and n >= TAKT_COMMITS:
        return f"{n} Commits und {stunden:.1f} h seit dem letzten vollen Lauf"
    return None


def takt_eintragen(voll):
    zeit, n = takt_lesen()
    open(takt_datei(), "w").write(f"{time.time()} 0\n" if voll else f"{zeit or 0} {n + 1}\n")


def sauber():
    return not any(git("status", "--porcelain"))


def getesteter_baum(precommit):
    """Baum (Tree-ID) des Stands, den dieser Lauf testet, oder None, wenn der Arbeitsstand davon abweicht. pre-commit:
    der Index, also der Baum des entstehenden Commits – nur, wenn Arbeitsverzeichnis und Index gleich sind und nichts
    Ungetracktes herumliegt (getestet wird das Arbeitsverzeichnis). Sonst: HEAD bei sauberem Stand."""
    if not precommit:
        return git("rev-parse", "HEAD^{tree}")[0] if sauber() else None
    if any(z and (z.startswith("??") or z[1] != " ") for z in git("status", "--porcelain")):
        return None
    return git("write-tree")[0] or None


def push(zeilen):
    """pre-push: jeden gepushten Stand, der noch nicht voll getestet ist, voll testen (genau diesen Stand)."""
    shas = []
    for z in zeilen:
        teile = z.split()
        if len(teile) == 4 and set(teile[1]) != {"0"} and teile[1] not in shas:
            shas.append(teile[1])
    schon = getestet()
    for sha in shas:
        baum = git("rev-parse", sha + "^{tree}")[0]
        if baum in schon:
            print(f"✓ {sha[:8]} schon voll getestet")
            continue
        if baum == git("rev-parse", "HEAD^{tree}")[0] and sauber():
            r = subprocess.run([sys.executable, os.path.join(HIER, "testen"), "--voll"], cwd=HIER)
        else:
            with tempfile.TemporaryDirectory(prefix="merge-train-push-") as tmp:
                ort = os.path.join(tmp, "baum")
                subprocess.run(["git", "-C", HIER, "worktree", "add", "-q", "--detach", ort, sha], check=True)
                try:
                    print(f"• {sha[:8]} im Temp-Worktree", flush=True)
                    r = subprocess.run([sys.executable, os.path.join(ort, "testen"), "--voll"], cwd=ort)
                finally:
                    subprocess.run(["git", "-C", HIER, "worktree", "remove", "--force", ort], capture_output=True)
        if r.returncode:
            sys.exit(1)
        eintragen(baum)  # auch wenn das testen dieses Stands noch keinen Merkzettel kannte
        schon.add(baum)


def schritt(titel, argv, env=None):
    t0 = time.time()
    r = subprocess.run(argv, capture_output=True, text=True, cwd=HIER, env=env)
    dauer = f"{time.time() - t0:.1f} s"
    if r.returncode:
        print(f"✗ {titel} ({dauer})\n")
        aus = (r.stdout + r.stderr).strip().splitlines()
        fehl = [z for z in aus if z.startswith(("FEHL", "FAIL", "ERROR", "Traceback")) or "Error" in z]
        print("\n".join(aus[-60:]) if not fehl or len(aus) <= 60 else "\n".join(fehl + ["…"] + aus[-30:]))
        sys.exit(1)
    print(f"✓ {titel} ({dauer})")


def main():
    args = sys.argv[1:]
    for v in ("GIT_DIR", "GIT_INDEX_FILE", "GIT_WORK_TREE", "GIT_PREFIX", "GIT_OBJECT_DIRECTORY", "GIT_EDITOR"):
        os.environ.pop(v, None)  # aus dem Hook: sonst arbeiten die git-Aufrufe der Tests in ihren Temp-Repos mit unserem Index
    if "--push" in args:
        return push(sys.stdin.read().splitlines())
    voll = "--voll" in args
    takt = not args  # pre-commit
    grund = voll_faellig() if takt else None
    if grund:
        global TAKT_VOLL
        voll = TAKT_VOLL = True
        print(f"• {grund} → --voll")
    baum = getesteter_baum(takt) if voll else None  # vor dem Lauf: danach eintragen
    seit = args[args.index("--seit") + 1] if "--seit" in args else "HEAD"
    pfade = geaendert(seit)
    pruefen, smoke, klassen, teile, gruende = auswahl(pfade, voll)
    idem = [p for p in pfade if p.endswith(".idem.sh") and os.path.exists(p)]
    if idem:
        gruende.append(" ".join(idem) + ": sh -n")
    for g in gruende:
        print("•", g)
    plan = [x for x in (pruefen and "pruefen", smoke and "Smoke",
                        klassen and ("Einzeltests: " + (klassen if klassen == "alle" else " ".join(klassen))),
                        teile and ("test_gitlab: " + " ".join(teile))) if x]
    if "--liste" in args:
        print("\n".join(plan) or "nichts zu testen")
        return
    if not plan and not idem:
        print("✓ nichts zu testen (" + (f"{len(pfade)} Datei(en), keine im Code" if pfade else "keine Änderungen") + ")")
        return
    for p in idem:
        schritt(f"{p} (sh -n)", ["sh", "-n", p])
    if pruefen:
        schritt("pruefen", [sys.executable, "pruefen"])
    if not smoke:
        return
    bau = os.path.join(TESTS, "bau", f"merge-train-{os.getpid()}")
    with tempfile.TemporaryDirectory(prefix="merge-train-smoke-") as tmp:
        open(f"{tmp}/leer.toml", "w").close()
        env = dict(os.environ, MERGE_TRAIN_CONFIG=f"{tmp}/leer.toml", XDG_CACHE_HOME=f"{tmp}/cache",
                   XDG_DATA_HOME=f"{tmp}/data", XDG_CONFIG_HOME=f"{tmp}/config", MERGE_TRAIN_SKRIPT=bau)
        try:
            schritt("Smoke: Bau und Import aller Module", [sys.executable, "-c",
                    "import subprocess, sys, importlib, pkgutil\n"
                    "subprocess.run([sys.executable, 'bauen', '--ziel', sys.argv[1]], check=True, capture_output=True)\n"
                    "sys.path.insert(0, sys.argv[1]); import merge_train\n"
                    "for i in pkgutil.iter_modules(merge_train.__path__): importlib.import_module('merge_train.' + i.name)",
                    bau], env)
            if klassen:
                schritt("Einzeltests" + ("" if klassen == "alle" else f" ({len(klassen)} Klassen)"),
                        [sys.executable, "tests/test_einheiten.py"] + ([] if klassen == "alle" else klassen))
            if teile:
                schritt("test_gitlab: " + " ".join(teile), [sys.executable, "tests/test_gitlab.py", *teile], env)
            if voll:
                schritt("UI-Tests (Browser)", [sys.executable, "tests/test_ui.py"])
            if baum:
                eintragen(baum)
        finally:
            for f in (bau, bau + ".neu"):
                if os.path.exists(f):
                    os.remove(f)


if __name__ == "__main__":
    main()
    if not sys.argv[1:]:  # pre-commit grün (ein Fehler endet vorher mit Exit 1)
        takt_eintragen(TAKT_VOLL)
