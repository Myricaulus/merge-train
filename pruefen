#!/usr/bin/env python3
"""Prüft src/merge_train/web/*.js|css mit Biome (https://biomejs.dev, `sudo pacman -Syu biome`) (ohne Biome: Syntax mit node).

  ./pruefen          Lint (Regeln in biome.json); Exit 1 bei Befunden
  ./pruefen --fix    sichere Korrekturen von Biome gleich anwenden (nur CSS)

Die JS-Dateien laufen im Browser zusammengehängt in einem <script> (Reihenfolge in web.py: JS_DATEIEN für die
Diff-Seiten, JS_START_DATEIEN für die Startseite). Jede Datei steckt in einer eigenen Funktion und sieht die anderen
nur über das globale App (app.js). Geprüft wird deshalb je Seite das Bündel, wie sie es bekommt, mit MR als dem, was
der Server davor setzt; Fundstellen werden auf Datei:Zeile zurückgerechnet. Ohne biome im PATH: mit node nur die
Syntax der Bündel (node --check), sonst Hinweis und Exit 0. Biome über node: `npm install -g @biomejs/biome`.

Vorher (immer, auch ohne Biome): werkzeug/app_pruefen.py – App-Namen, Ladereihenfolge und Kopfkommentare der Dateien.
"""
import ast, json, os, re, shutil, subprocess, sys, tempfile

HIER = os.path.dirname(os.path.realpath(__file__))
WEB = os.path.join(HIER, "src", "merge_train", "web")
KONFIG = os.path.join(HIER, "biome.json")
VORSPANN = "const MR={};"  # setzt die Seite vor den Skripten


def buendel_aus_web_py():
    """(Name, Dateien) je Seite, aus den Listen in web.py."""
    baum = ast.parse(open(os.path.join(HIER, "src", "merge_train", "web.py"), encoding="utf-8").read())
    listen = {z.targets[0].id: ast.literal_eval(z.value) for z in baum.body
              if isinstance(z, ast.Assign) and isinstance(z.targets[0], ast.Name) and z.targets[0].id.endswith("_DATEIEN")}
    return [("diffseite", listen["JS_DATEIEN"]), ("startseite", listen["JS_START_DATEIEN"])]


def buendel_schreiben(ziel, dateien):
    """Schreibt das Bündel und liefert die Zeilenzuordnung [(erste Bündelzeile, Datei)]."""
    teile, karte, zeile = [VORSPANN + "\n"], [], 2
    for f in dateien:
        text = open(os.path.join(WEB, f), encoding="utf-8").read()
        if not text.endswith("\n"):
            text += "\n"
        karte.append((zeile, f))
        teile.append(text)
        zeile += text.count("\n")
    open(ziel, "w", encoding="utf-8").write("".join(teile))
    return karte


def zurueck(karte, z):
    for start, f in reversed(karte):
        if z >= start:
            return f, z - start + 1
    return "(Vorspann)", z


def biome(*args):
    r = subprocess.run(["biome", *args, "--config-path", KONFIG, "--reporter=json", "--max-diagnostics=none"],
                       capture_output=True, text=True, cwd=HIER)
    try:
        return json.loads(r.stdout).get("diagnostics", [])
    except json.JSONDecodeError:
        sys.exit(r.stdout + r.stderr)


def zeile_von(d):
    return ((d.get("location") or {}).get("start") or {}).get("line", 0)


def ausgeben(d, datei, z):
    regel = (d.get("category") or "").removeprefix("lint/")
    text = re.sub(r"\s+", " ", d.get("message") or "").strip()
    print(f"src/merge_train/web/{datei}:{z}  {regel}  {text}")


def syntax_mit_node():
    """Ohne Biome: nur Syntax der Bündel mit node --check. Rückgabe 1 bei Fehlern."""
    fehler = 0
    with tempfile.TemporaryDirectory() as tmp:
        for name, dateien in buendel_aus_web_py():
            pfad = os.path.join(tmp, name + ".js")
            karte = buendel_schreiben(pfad, dateien)
            r = subprocess.run(["node", "--check", pfad], capture_output=True, text=True)
            if r.returncode:
                m = re.search(re.escape(pfad) + r":(\d+)", r.stderr)
                f, z = zurueck(karte, int(m.group(1))) if m else ("?", 0)
                zeilen = [l for l in r.stderr.splitlines() if "Error" in l]
                print(f"src/merge_train/web/{f}:{z}  {zeilen[0] if zeilen else r.stderr.strip()}")
                fehler = 1
    print("biome nicht gefunden – nur Syntax mit node geprüft" + (" (Fehler)" if fehler else ", ok")
          + "; Lint: npm install -g @biomejs/biome")
    return fehler


def main():
    app = subprocess.run([sys.executable, os.path.join(HIER, "werkzeug", "app_pruefen.py")])
    if not shutil.which("biome"):
        if shutil.which("node"):
            sys.exit(syntax_mit_node() or app.returncode)
        print("biome nicht gefunden – Lint übersprungen (sudo pacman -Syu biome oder npm install -g @biomejs/biome)")
        sys.exit(app.returncode)
    gesehen, n = set(), 0
    with tempfile.TemporaryDirectory() as tmp:
        for name, dateien in buendel_aus_web_py():
            pfad = os.path.join(tmp, name + ".js")
            karte = buendel_schreiben(pfad, dateien)
            for d in biome("lint", pfad):
                f, z = zurueck(karte, zeile_von(d))
                schluessel = (f, z, d.get("category"), d.get("message"))
                if schluessel in gesehen:  # Dateien der Startseite stecken in beiden Bündeln
                    continue
                gesehen.add(schluessel)
                ausgeben(d, f, z)
                n += 1
    css = [os.path.join(WEB, f) for f in sorted(os.listdir(WEB)) if f.endswith(".css")]
    if "--fix" in sys.argv:
        subprocess.run(["biome", "lint", "--write", "--config-path", KONFIG, *css], cwd=HIER, capture_output=True)
    for d in biome("lint", *css):
        ausgeben(d, os.path.basename((d.get("location") or {}).get("path") or "?"), zeile_von(d))
        n += 1
    if n:
        sys.exit(f"\n{n} Befund(e)")
    print("src/merge_train/web: keine Befunde von Biome")
    sys.exit(app.returncode)


if __name__ == "__main__":
    main()
