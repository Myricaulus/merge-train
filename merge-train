.durch{{display:grid;place-items:center;min-height:100vh;text-align:center}} .durch div{{font-size:22vmin;line-height:1.25;margin-bottom:2vmin}}
.durch p{{font-size:20px;margin:12px 0 0}} .durch code{{font-size:.9em}}</style></head>
<body><main class="durch"><section><div>👍</div><p>Alles durch – überall reviewed = claude</p>
<p class="sub">Neue Commits holt <code>merge-train</code> beim nächsten Aufruf.</p></section></main></body></html>"""
LEERLAUF_S = 3600

def server_laeuft():
    import urllib.request
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{PORT}/ping", timeout=0.5) as r:
            return r.read() == b"merge-train"
    except OSError:
        return False

def server_sicherstellen():
    import time
    if server_laeuft():
        return True
    log = open(os.path.join(ORDNER, "server.log"), "a")
    subprocess.Popen([sys.executable, os.path.realpath(__file__), "--server"], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=log, stderr=log)
    for _ in range(40):
        time.sleep(0.1)
        if server_laeuft():
            return True
    return False

def server():
    """Liefert ~/.cache/merge-train auf 127.0.0.1 aus, erzeugt Seiten beim Abruf frisch, nimmt „fertig“ an.
    Beendet sich nach LEERLAUF_S ohne Anfrage."""
    import json, time
    from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
    schluessel()
    zuletzt = [time.time()]
    herkunft = f"http://127.0.0.1:{PORT}"

    class H(BaseHTTPRequestHandler):
        def log_message(self, *a): pass
        def senden(self, code, body, typ="text/html; charset=utf-8"):
            if isinstance(body, str): body = body.encode()
            self.send_response(code); self.send_header("Content-Type", typ)
            self.send_header("Cache-Control", "no-store"); self.send_header("Content-Length", str(len(body)))
            self.end_headers(); self.wfile.write(body)
        def do_GET(self):
            zuletzt[0] = time.time()
            pfad = self.path.split("?", 1)[0].lstrip("/")
            try:
                if pfad == "ping":
                    return self.senden(200, "merge-train", "text/plain")
                repos = {dateiname(projektname(r)): r for r in finde_repos()}
                if pfad == "zug.js":
                    zug_schreiben([statistik(r) for r in repos.values()])
                    return self.senden(200, open(os.path.join(ORDNER, "zug.js"), "rb").read(),
                                       "text/javascript; charset=utf-8")
                if pfad == "":
                    wagen = zug_schreiben([statistik(r) for r in repos.values()])
                    offen = [w for w in wagen if w["status"] == "offen"]
                    if not offen:
                        return self.senden(200, ALLES_DURCH)
                    self.send_response(302); self.send_header("Location", "/" + offen[0]["datei"]); self.end_headers(); return
                if pfad in repos:
                    datei = seite_schreiben(repos[pfad], "reviewed", "claude")
                    return self.senden(200, open(datei, "rb").read())
                self.senden(404, "nicht gefunden", "text/plain")
            except Exception as e:  # Fehler zeigen statt Verbindung abbrechen
                self.senden(500, f"merge-train: {e}", "text/plain; charset=utf-8")
        def do_POST(self):
            zuletzt[0] = time.time()
            if self.path != "/fertig" or self.headers.get("Origin", herkunft) != herkunft:
                return self.senden(403, "verboten", "text/plain")
            try:
                d = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))))
                ok, text = fertig(str(d.get("projekt", "")), str(d.get("sha", "")), str(d.get("k", "")))
                wagen = json.loads(open(os.path.join(ORDNER, "zug.js")).read()[len("window.MR_ZUG="):-1])["wagen"]
                self.senden(200 if ok else 400, json.dumps({"ok": ok, "text": text, "wagen": wagen}, ensure_ascii=False),
                            "application/json")
            except Exception as e:
                self.senden(500, json.dumps({"ok": False, "text": f"merge-train: {e}"}), "application/json")

    srv = ThreadingHTTPServer(("127.0.0.1", PORT), H)
    skript = os.path.realpath(__file__)
    stand = os.path.getmtime(skript)
    neu = [False]
    def waechter():
        while time.time() - zuletzt[0] < LEERLAUF_S:
            time.sleep(2)
            try:
                geaendert = os.path.getmtime(skript) != stand
            except OSError:  # Skript umbenannt/gelöscht: beenden
                break
            if geaendert:  # Skript wurde geändert: mit neuem Code weitermachen
                neu[0] = True; break
        srv.shutdown()
    threading.Thread(target=waechter, daemon=True).start()
    srv.serve_forever()
    srv.server_close()
    if neu[0]:
        os.execv(sys.executable, [sys.executable, skript, "--server"])

def main():
    ap = argparse.ArgumentParser(description="merge-train: Merge-Requests claude → reviewed aller Projekte")
    ap.add_argument("ordner", nargs="?", help="nur dieses Projekt (Ordner oder Name unter ~/Projects); ohne: der ganze Zug, beginnend beim größten")
    ap.add_argument("--von", default="reviewed")
    ap.add_argument("--bis", default="claude")
    ap.add_argument("--alle", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--inline", action="store_true", help="inline statt nebeneinander starten")
    ap.add_argument("--nur-datei", action="store_true", help="HTML erzeugen, nicht öffnen")
    ap.add_argument("--server", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--projekte", action="store_true", help=argparse.SUPPRESS)  # für die Shell-Vervollständigung
    o = ap.parse_args()
    if o.server:
        return server()
    if o.projekte:
        from concurrent.futures import ThreadPoolExecutor
        with ThreadPoolExecutor(8) as ex:
            st = list(ex.map(statistik, finde_repos()))
        st.sort(key=lambda w: (not w["dateien"], -(w["plus"] + w["minus"])))
        for w in st:
            print(f'{w["p"]}\t+{w["plus"]} −{w["minus"]} · {w["dateien"]} Datei(en)' if w["dateien"] else f'{w["p"]}\taktuell')
        return
    wurzel = None
    if o.ordner:  # ohne Projekt: immer der ganze Zug
        ordner = o.ordner
        if o.ordner and not os.path.exists(ordner):
            ordner = os.path.join(PROJEKTE, o.ordner)
        wurzel = (git(ordner, "rev-parse", "--show-toplevel", check=False) or "").strip() or None
        if o.ordner and not wurzel:
            sys.exit(f"merge-train: kein Git-Repo: {o.ordner}")
    if wurzel and not all(git(wurzel, "rev-parse", "--verify", "-q", b, check=False) for b in (o.von, o.bis)):
        sys.exit(f"merge-train: Branch {o.von} oder {o.bis} fehlt in {wurzel}")
    repos, wagen = alles_erzeugen(o.von, o.bis, o.inline)
    if wurzel:
        if projektname(wurzel) not in {w["p"] for w in wagen}:
            seite_schreiben(wurzel, o.von, o.bis, o.inline)
        ziel = os.path.join(ORDNER, dateiname(projektname(wurzel)))
    else:
        offen = [w for w in wagen if w["status"] == "offen"]
        if not offen:
            print("merge-train: nichts zu prüfen – überall reviewed = claude"); return
        ziel = os.path.join(ORDNER, offen[0]["datei"])
    if o.nur_datei or o.von != "reviewed" or o.bis != "claude" or o.inline:
        print(ziel)
        if not o.nur_datei:
            oeffnen(ziel)
        return
    url = f"http://127.0.0.1:{PORT}/{os.path.basename(ziel)}" if server_sicherstellen() else ziel
    print(url)
    oeffnen(url)

if __name__ == "__main__":
    main()
