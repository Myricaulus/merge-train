{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "useTemplate": "off", "noDescendingSpecificity": "off" },
      "suspicious": { "noAssignInExpressions": "off", "useIterableCallbackReturn": "off" },
      "complexity": { "useOptionalChain": "off" },
      "correctness": { "noUndeclaredVariables": "error" }
    }
  }
}
