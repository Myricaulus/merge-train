# fish-Vervollständigung für merge-train (verlinkt nach ~/.config/fish/completions/)
# Zugleich die Kurzübersicht der Befehle für Agenten (Skill merge-train): eine Zeile je Befehl, Details mit --help.
complete -c merge-train -f
complete -c merge-train -n '__fish_is_first_arg; and not string match -q -- "-*" (commandline -ct)' -a '(merge-train --projekte 2>/dev/null)'
complete -c merge-train -n '__fish_is_first_arg' -l nur-datei -d 'nur die URL ausgeben, nicht öffnen'
complete -c merge-train -n '__fish_is_first_arg' -l mrs -d 'GitLab-MRs zum Review'
complete -c merge-train -n '__fish_is_first_arg' -l stopp -d 'Server beenden (mit --beobachten: den dieses Repos)'
complete -c merge-train -n '__fish_is_first_arg' -l beobachten -d 'Arbeitsverzeichnis live gegen HEAD bzw. --von beobachten'
complete -c merge-train -l von -x -a '(git branch --format="%(refname:short)" 2>/dev/null)' -d 'mit --beobachten: Vergleichsstand'
complete -c merge-train -s h -l help -d 'Hilfe anzeigen'

# Agent: zuerst status, dann was status nennt
set -l agent_befehle status feedback antworten thread horchen kommentar kommentare zeigen pruefen vorfall
complete -c merge-train -n '__fish_is_first_arg' -a status -d 'Agent, zuerst: Branch, Änderungen, offene Fäden, was jetzt tun'
complete -c merge-train -n '__fish_is_first_arg' -a agent -d 'Befehle für Agenten'
complete -c merge-train -n "__fish_seen_subcommand_from agent; and not __fish_seen_subcommand_from $agent_befehle" -a status -d 'zuerst: Branch, Änderungen, offene Fäden, was jetzt tun'
complete -c merge-train -n "__fish_seen_subcommand_from agent; and not __fish_seen_subcommand_from $agent_befehle" -a thread -d 'neuer Faden: --ort pfad:von-bis, --siehe, --vergleich A B, ohne --ort allgemein'
complete -c merge-train -n "__fish_seen_subcommand_from agent; and not __fish_seen_subcommand_from $agent_befehle" -a antworten -d 'an Faden <id> anhängen (--siehe, --vergleich, --erledigt)'
complete -c merge-train -n "__fish_seen_subcommand_from agent; and not __fish_seen_subcommand_from $agent_befehle" -a feedback -d 'wartende Fragen des Nutzers abholen (--alle, --horchen)'
complete -c merge-train -n "__fish_seen_subcommand_from agent; and not __fish_seen_subcommand_from $agent_befehle" -a horchen -d 'im Hintergrund auf neue Nachrichten warten'
complete -c merge-train -n "__fish_seen_subcommand_from agent; and not __fish_seen_subcommand_from $agent_befehle" -a kommentar -d 'GitLab-Kommentar umformulieren (draft ändern, sonst neuer daneben)'
complete -c merge-train -n "__fish_seen_subcommand_from agent; and not __fish_seen_subcommand_from $agent_befehle" -a kommentare -d 'am MR schon Kommentiertes lesen'
complete -c merge-train -n "__fish_seen_subcommand_from agent; and not __fish_seen_subcommand_from $agent_befehle" -a zeigen -d 'Review-JSON beim MR anmelden und öffnen'
complete -c merge-train -n "__fish_seen_subcommand_from agent; and not __fish_seen_subcommand_from $agent_befehle" -a pruefen -d 'Review-JSON gegen den MR-Stand prüfen (--seit)'
complete -c merge-train -n "__fish_seen_subcommand_from agent; and not __fish_seen_subcommand_from $agent_befehle" -a vorfall -d 'Bericht, wo merge-train in die Irre geführt hat (--art bug|wunsch): todo, sonst Datei (Issue nur mit vorfall_github)'
complete -c merge-train -n '__fish_seen_subcommand_from thread' -l ort -x -d 'pfad:zeile oder pfad:von-bis (mit grep -n gemessen)'
complete -c merge-train -n '__fish_seen_subcommand_from thread antworten' -l siehe -x -d 'pfad[:zeile[-bis]][@ziel|@basis|@ref][|Label]: Aufrufer, Test, altes Verhalten, Stand auf dem Ziel'
complete -c merge-train -n '__fish_seen_subcommand_from thread antworten' -l vergleich -x -d 'A[:von-bis] B[:von-bis][|Label]: nebeneinander'
complete -c merge-train -n '__fish_seen_subcommand_from antworten' -l erledigt -d 'Wunsch umgesetzt'
complete -c merge-train -n '__fish_seen_subcommand_from feedback' -l alle -d 'auch beantwortete Fäden'
complete -c merge-train -n '__fish_seen_subcommand_from feedback' -l horchen -d 'was wartet sofort, sonst horchen'
complete -c merge-train -n '__fish_seen_subcommand_from thread antworten horchen kommentar feedback' -l als -x -d 'Harness (Modell), wenn nicht erkannt'
complete -c merge-train -n '__fish_seen_subcommand_from thread antworten feedback horchen kommentar kommentare' -s p -l projekt -x -d 'Projekt oder MR'
complete -c merge-train -n '__fish_seen_subcommand_from zeigen pruefen' -F -a '(__fish_complete_suffix .json)'
complete -c merge-train -n '__fish_seen_subcommand_from zeigen pruefen' -l mr -x -d 'MR-URL oder !iid'
complete -c merge-train -n '__fish_seen_subcommand_from zeigen' -l nicht-oeffnen -d 'nur URL ausgeben'
complete -c merge-train -n '__fish_seen_subcommand_from pruefen' -l seit -d 'Review-Update: Stand seit COMMIT'
complete -c merge-train -n '__fish_seen_subcommand_from vorfall' -l art -x -a 'bug wunsch' -d 'Art des Berichts'
