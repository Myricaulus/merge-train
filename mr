#!/usr/bin/env python3
"""mr – Merge-Request-Ansicht reviewed ← claude, sofort im Browser.

Aufruf:
  mr [ordner] [--von reviewed] [--bis claude] [--meld] [--inline]

Erzeugt eine HTML-Seite wie der „Changes“-Reiter in GitLab:
Commits, Dateiliste mit +/-, alle Diffs nebeneinander (Taste i: inline),
und öffnet sie im Browser. Verglichen wird wie in GitLab ab dem
gemeinsamen Vorgänger (reviewed...claude).

Tasten: j/k nächste/vorige Datei, i nebeneinander/inline, z alle zu/auf.
--meld öffnet stattdessen Meld mit dem Ordnervergleich.
"""
import argparse, difflib, html, os, re, subprocess, sys, webbrowser
from datetime import datetime

def git(ordner, *a):
    return subprocess.run(["git", "-C", ordner, *a], capture_output=True,
                          text=True, errors="replace", check=True).stdout

def zerlegen(diff):
    """Unified-Diff in Dateien → Hunks → Zeilen zerlegen."""
    dateien, d, h = [], None, None
    for z in diff.splitlines():
        if z.startswith("diff --git "):
            m = re.match(r"diff --git a/(.*) b/(.*)", z)
            d = {"alt": m.group(1), "neu": m.group(2), "hunks": [], "binaer": False,
                 "status": "geändert", "plus": 0, "minus": 0}
            dateien.append(d); h = None
        elif d is None:
            continue
        elif z.startswith("new file"): d["status"] = "neu"
        elif z.startswith("deleted file"): d["status"] = "gelöscht"
        elif z.startswith("rename from"): d["status"] = "umbenannt"
        elif z.startswith("Binary files"): d["binaer"] = True
        elif z.startswith("@@"):
            m = re.match(r"@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@(.*)", z)
            h = {"a": int(m.group(1)), "b": int(m.group(2)), "kopf": m.group(3).strip(), "z": []}
            d["hunks"].append(h)
        elif h is not None and z[:1] in (" ", "+", "-"):
            h["z"].append((z[0], z[1:]))
            if z[0] == "+": d["plus"] += 1
            if z[0] == "-": d["minus"] += 1
    return dateien

def markieren(a, b):
    """Geänderte Teile innerhalb einer Zeile hervorheben."""
    if len(a) + len(b) > 4000:
        return html.escape(a), html.escape(b)
    sm = difflib.SequenceMatcher(None, a, b, autojunk=False)
    ra, rb = [], []
    for op, i1, i2, j1, j2 in sm.get_opcodes():
        ta, tb = html.escape(a[i1:i2]), html.escape(b[j1:j2])
        if op == "equal":
            ra.append(ta); rb.append(tb)
        else:
            if ta: ra.append(f"<del>{ta}</del>")
            if tb: rb.append(f"<ins>{tb}</ins>")
    return "".join(ra), "".join(rb)

def hunk_zeilen(h):
    """Zeilen paaren: (typ, nr_a, text_a, nr_b, text_b)."""
    rows, a, b, i, z = [], h["a"], h["b"], 0, h["z"]
    while i < len(z):
        if z[i][0] == " ":
            t = html.escape(z[i][1]); rows.append(("ctx", a, t, b, t)); a += 1; b += 1; i += 1
            continue
        weg, dazu = [], []
        while i < len(z) and z[i][0] == "-": weg.append(z[i][1]); i += 1
        while i < len(z) and z[i][0] == "+": dazu.append(z[i][1]); i += 1
        for k in range(max(len(weg), len(dazu))):
            ta = weg[k] if k < len(weg) else None
            tb = dazu[k] if k < len(dazu) else None
            if ta is not None and tb is not None:
                ha, hb = markieren(ta, tb)
            else:
                ha = html.escape(ta) if ta is not None else None
                hb = html.escape(tb) if tb is not None else None
            rows.append(("chg", a if ta is not None else None, ha, b if tb is not None else None, hb))
            if ta is not None: a += 1
            if tb is not None: b += 1
    return rows

def datei_html(n, d):
    name = d["neu"] if d["alt"] == d["neu"] else f'{d["alt"]} → {d["neu"]}'
    kopf = (f'<summary><span class="st st-{d["status"]}">{d["status"]}</span> '
            f'<b>{html.escape(name)}</b> <span class="p">+{d["plus"]}</span> '
            f'<span class="m">−{d["minus"]}</span></summary>')
    if d["binaer"]:
        return f'<details open class="datei" id="d{n}">{kopf}<div class="leer">Binärdatei</div></details>'
    if not d["hunks"]:
        return f'<details open class="datei" id="d{n}">{kopf}<div class="leer">keine Inhaltsänderung</div></details>'
    sbs, inl = [], []
    for h in d["hunks"]:
        hk = html.escape(f'@@ -{h["a"]} +{h["b"]} @@ {h["kopf"]}')
        sbs.append(f'<tr class="hk"><td colspan="4">{hk}</td></tr>')
        inl.append(f'<tr class="hk"><td colspan="3">{hk}</td></tr>')
        for typ, na, ta, nb, tb in hunk_zeilen(h):
            if typ == "ctx":
                sbs.append(f'<tr><td class="n">{na}</td><td class="c">{ta}</td><td class="n">{nb}</td><td class="c">{tb}</td></tr>')
                continue
            la = f'<td class="n">{na}</td><td class="c weg">{ta}</td>' if ta is not None else '<td class="n"></td><td class="c nix"></td>'
            lb = f'<td class="n">{nb}</td><td class="c dazu">{tb}</td>' if tb is not None else '<td class="n"></td><td class="c nix"></td>'
            sbs.append(f"<tr>{la}{lb}</tr>")
        inl.extend(inline_bloecke(h))  # inline: je Block erst alle weg, dann alle dazu
    return (f'<details open class="datei" id="d{n}">{kopf}'
            f'<table class="sbs">{"".join(sbs)}</table>'
            f'<table class="inl">{"".join(inl)}</table></details>')

def inline_bloecke(h):
    rows = hunk_zeilen(h)
    out, weg, dazu = [], [], []
    def leeren():
        for na, ta in weg: out.append(f'<tr><td class="n">{na}</td><td class="n"></td><td class="c weg">{ta}</td></tr>')
        for nb, tb in dazu: out.append(f'<tr><td class="n"></td><td class="n">{nb}</td><td class="c dazu">{tb}</td></tr>')
        weg.clear(); dazu.clear()
    for typ, na, ta, nb, tb in rows:
        if typ == "ctx":
            leeren(); out.append(f'<tr><td class="n">{na}</td><td class="n">{nb}</td><td class="c">{ta}</td></tr>')
        else:
            if ta is not None: weg.append((na, ta))
            if tb is not None: dazu.append((nb, tb))
    leeren()
    return out

CSS = """
