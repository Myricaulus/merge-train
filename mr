JS = """
const ds=[...document.querySelectorAll('.datei')];let i=-1;
function geh(k){if(!ds.length)return;i=Math.max(0,Math.min(ds.length-1,k));ds[i].open=true;ds[i].scrollIntoView({block:'start'});}
document.addEventListener('keydown',e=>{if(e.ctrlKey||e.altKey||e.metaKey)return;
 const y=window.scrollY;if(e.key==='j'||e.key==='k'){i=ds.findIndex(d=>d.offsetTop>y+5)-1;if(i<-1)i=ds.length-1;}
 if(e.key==='j')geh(i+1);else if(e.key==='k')geh(e.key==='k'&&ds[i]&&ds[i].offsetTop<y-5?i:i-1);
 else if(e.key==='i'){document.body.classList.toggle('inline');try{localStorage.mrInline=document.body.classList.contains('inline')?1:''}catch(_){}}
 else if(e.key==='z'){const zu=ds.some(d=>d.open);ds.forEach(d=>d.open=!zu);}});
try{if(localStorage.mrInline)document.body.classList.add('inline')}catch(_){}
"""

def main():
    ap = argparse.ArgumentParser(description="Merge-Request-Ansicht reviewed ← claude")
    ap.add_argument("ordner", nargs="?", default=".")
    ap.add_argument("--von", default="reviewed")
    ap.add_argument("--bis", default="claude")
    ap.add_argument("--meld", action="store_true", help="Meld-Ordnervergleich statt Browser")
    ap.add_argument("--inline", action="store_true", help="inline statt nebeneinander starten")
    ap.add_argument("--nur-datei", action="store_true", help="HTML erzeugen, nicht öffnen")
    o = ap.parse_args()
    try:
        wurzel = git(o.ordner, "rev-parse", "--show-toplevel").strip()
        for b in (o.von, o.bis):
            git(wurzel, "rev-parse", "--verify", "-q", b)
    except subprocess.CalledProcessError as e:
        sys.exit(f"mr: kein Git-Repo oder Branch fehlt ({o.von}/{o.bis}) in {o.ordner}")
    projekt = os.path.relpath(wurzel, os.path.expanduser("~/Projects")) if wurzel.startswith(os.path.expanduser("~/Projects/")) else os.path.basename(wurzel)
    bereich = f"{o.von}...{o.bis}"

    if o.meld:
        subprocess.Popen(["git", "-C", wurzel, "difftool", "--dir-diff", "--tool=meld", "--no-prompt", bereich],
                         start_new_session=True)
        return

    commits = git(wurzel, "log", "--reverse", "--format=%h\x1f%ad\x1f%s", "--date=format:%d.%m. %H:%M", f"{o.von}..{o.bis}")
    diff = git(wurzel, "diff", "--find-renames", "-U4", "--no-color", bereich)
    dateien = zerlegen(diff)
    plus = sum(d["plus"] for d in dateien); minus = sum(d["minus"] for d in dateien)
    todos = sorted(set(re.findall(r"todo:([\w.-]+)", git(wurzel, "log", "--format=%B", f"{o.von}..{o.bis}"))))

    cl = "".join(f'<li><code>{html.escape(h)}</code> {html.escape(s)} <span class="sub">{html.escape(t)}</span></li>'
                 for h, t, s in (z.split("\x1f") for z in commits.splitlines() if z))
    fl = "".join(f'<li><a href="#d{n}">{html.escape(d["neu"])}</a> <span class="p">+{d["plus"]}</span> '
                 f'<span class="m">−{d["minus"]}</span> <span class="sub">{d["status"] if d["status"]!="geändert" else ""}</span></li>'
                 for n, d in enumerate(dateien))
    td = (f'<div class="box"><h2>todos</h2><ul>{"".join(f"<li><code>{html.escape(t)}</code></li>" for t in todos)}</ul></div>'
          if todos else "")
    leer = '<div class="box"><div class="leer">Keine Unterschiede – reviewed ist auf dem Stand von claude.</div></div>' if not dateien else ""
    seite = f"""<!doctype html><html lang="de"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><title>MR {html.escape(projekt)}</title>
<style>{CSS}</style></head><body class="{'inline' if o.inline else ''}">
<h1>{html.escape(projekt)}: {html.escape(o.von)} ← {html.escape(o.bis)}</h1>
<div class="sub">{len(commits.splitlines())} Commit(s) · {len(dateien)} Datei(en) · <span class="p">+{plus}</span> <span class="m">−{minus}</span> · erzeugt {datetime.now():%d.%m.%Y %H:%M}</div>
{leer}<div class="box"><h2>Commits</h2><ul>{cl or '<li class="sub">keine</li>'}</ul></div>{td}
<div class="box"><h2>Dateien</h2><ul>{fl}</ul></div>
{"".join(datei_html(n, d) for n, d in enumerate(dateien))}
<div class="hilfe">j/k Datei · i inline · z zu/auf</div>
<script>{JS}</script></body></html>"""
    ziel_dir = os.path.expanduser("~/.cache/mr")
    os.makedirs(ziel_dir, exist_ok=True)
    ziel = os.path.join(ziel_dir, projekt.replace("/", "_") + ".html")
    with open(ziel, "w") as f:
        f.write(seite)
    print(ziel)
    if not o.nur_datei:
        subprocess.Popen(["xdg-open", ziel], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

if __name__ == "__main__":
    main()
