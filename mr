#!/usr/bin/env python3
"""mr – Merge-Request-Ansicht reviewed ← claude, sofort im Browser.

Aufruf:
  mr [ordner] [--von reviewed] [--bis claude] [--meld] [--inline] [--nur-datei]

Erzeugt eine HTML-Seite wie der „Changes“-Reiter in GitLab und öffnet sie:
oben (schwebend) Commits mit vollen Nachrichten, links (schwebend) die
Dateiliste, rechts alle Diffs nebeneinander mit Syntaxhervorhebung.
Verglichen wird wie in GitLab ab dem gemeinsamen Vorgänger (reviewed...claude).

Tasten: j/k nächste/vorige Datei, i nebeneinander/inline, z alle zu/auf,
c Commits ein-/ausklappen.  --meld öffnet stattdessen Meld (Ordnervergleich).
"""
import argparse, difflib, html, os, re, subprocess, sys
from datetime import datetime

try:
    from pygments.lexers import get_lexer_for_filename, get_lexer_by_name
    from pygments.util import ClassNotFound
    from pygments import token as T
    PYGMENTS = True
except ImportError:
    PYGMENTS = False

# ---------------------------------------------------------------- git

def git(ordner, *a, check=True):
    r = subprocess.run(["git", "-C", ordner, *a], capture_output=True,
                       text=True, errors="replace")
    if check and r.returncode:
        raise subprocess.CalledProcessError(r.returncode, a, r.stdout, r.stderr)
    return r.stdout if r.returncode == 0 else None

def zerlegen(diff):
    """Unified-Diff in Dateien → Hunks → Zeilen zerlegen."""
    dateien, d, h = [], None, None
    for z in diff.splitlines():
        if z.startswith("diff --git "):
            m = re.match(r"diff --git a/(.*) b/(.*)", z)
            d = {"alt": m.group(1), "neu": m.group(2), "hunks": [], "binaer": False,
                 "status": "geändert", "plus": 0, "minus": 0}
            dateien.append(d); h = None
        elif d is None:
            continue
        elif h is None and z.startswith("new file"): d["status"] = "neu"
        elif h is None and z.startswith("deleted file"): d["status"] = "gelöscht"
        elif h is None and z.startswith("rename from"): d["status"] = "umbenannt"
        elif h is None and z.startswith("Binary files"): d["binaer"] = True
        elif z.startswith("@@"):
            m = re.match(r"@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@(.*)", z)
            h = {"a": int(m.group(1)), "b": int(m.group(2)), "kopf": m.group(3).strip(), "z": []}
            d["hunks"].append(h)
        elif h is not None and z[:1] in (" ", "+", "-"):
            h["z"].append((z[0], z[1:]))
            if z[0] == "+": d["plus"] += 1
            if z[0] == "-": d["minus"] += 1
    return dateien

# ---------------------------------------------------------------- Syntax

SONDER = {".razor": "html", ".cshtml": "html", ".vue": "html", ".svelte": "html",
          ".conf": "ini", ".service": "ini", ".desktop": "ini", ".webmanifest": "json"}

def lexer_fuer(pfad):
    if not PYGMENTS:
        return None
    ext = os.path.splitext(pfad)[1].lower()
    try:
        if ext in SONDER:
            return get_lexer_by_name(SONDER[ext], stripnl=False, ensurenl=False)
        return get_lexer_for_filename(pfad, stripnl=False, ensurenl=False)
    except ClassNotFound:
        return None

def klasse(tt):
    if not PYGMENTS: return ""
    if tt in T.Comment: return "tc"
    if tt in T.String or tt in T.Literal.String: return "ts"
    if tt in T.Number: return "tn"
    if tt in T.Keyword: return "tk"
    if tt in T.Name.Tag: return "tt"
    if tt in T.Name.Attribute: return "ta"
    if tt in T.Name.Function or tt in T.Name.Class: return "tf"
    if tt in T.Name.Builtin or tt in T.Name.Decorator: return "tb"
    if tt in T.Name.Variable: return "tv"
    if tt in T.Operator: return "to"
    if tt in T.Generic.Heading or tt in T.Generic.Subheading: return "tk"
    return ""

def zeilen_tokens(text, pfad):
    """Ganze Datei lexen (damit mehrzeilige Kommentare/Strings stimmen),
    Ergebnis: Liste je Zeile von (klasse, text)."""
    lx = lexer_fuer(pfad)
    if lx is None or text is None or len(text) > 2_000_000:
        return None
    zeilen, akt = [], []
    for tt, wert in lx.get_tokens(text):
        k = klasse(tt)
        teile = wert.split("\n")
        for i, t in enumerate(teile):
            if i:
                zeilen.append(akt); akt = []
            if t:
                akt.append((k, t))
    zeilen.append(akt)
    return zeilen

def darstellen(toks, roh, bereiche, tag):
    """Zeile als HTML: Syntaxklassen + markierte Änderungsbereiche (tag = del/ins)."""
    if toks is None or "".join(t for _, t in toks) != roh:
        toks = [("", roh)]
    grenzen = sorted({0, len(roh), *[x for b in bereiche for x in b]})
    def geaendert(p):
        return any(a <= p < b for a, b in bereiche)
    out, pos = [], 0
    for k, t in toks:
        ende = pos + len(t)
        schnitte = [g for g in grenzen if pos < g < ende]
        start = pos
        for g in schnitte + [ende]:
            stueck = html.escape(roh[start:g])
            if k: stueck = f'<span class="{k}">{stueck}</span>'
            if bereiche and geaendert(start): stueck = f"<{tag}>{stueck}</{tag}>"
            out.append(stueck); start = g
        pos = ende
    return "".join(out)

def intraline(a, b):
    """Geänderte Bereiche in a und b, nur wenn sich die Zeilen ähneln."""
    if len(a) + len(b) > 4000:
        return [], []
    sm = difflib.SequenceMatcher(None, a, b, autojunk=False)
    if sm.ratio() < 0.5:
        return [], []
    ra, rb = [], []
    for op, i1, i2, j1, j2 in sm.get_opcodes():
        if op != "equal":
            if i2 > i1: ra.append((i1, i2))
            if j2 > j1: rb.append((j1, j2))
    return ra, rb

# ---------------------------------------------------------------- HTML

def hunk_zeilen(h, ta_tok, tb_tok):
    """Zeilen paaren: (typ, nr_a, html_a, nr_b, html_b)."""
    def tok(tabelle, nr):
        return tabelle[nr - 1] if tabelle and 0 < nr <= len(tabelle) else None
    rows, a, b, i, z = [], h["a"], h["b"], 0, h["z"]
    while i < len(z):
        if z[i][0] == " ":
            t = z[i][1]
            rows.append(("ctx", a, darstellen(tok(ta_tok, a), t, [], ""),
                         b, darstellen(tok(tb_tok, b), t, [], "")))
            a += 1; b += 1; i += 1
            continue
        weg, dazu = [], []
        while i < len(z) and z[i][0] == "-": weg.append(z[i][1]); i += 1
        while i < len(z) and z[i][0] == "+": dazu.append(z[i][1]); i += 1
        for k in range(max(len(weg), len(dazu))):
            ta = weg[k] if k < len(weg) else None
            tb = dazu[k] if k < len(dazu) else None
            ba, bb = intraline(ta, tb) if ta is not None and tb is not None else ([], [])
            ha = darstellen(tok(ta_tok, a), ta, ba, "del") if ta is not None else None
            hb = darstellen(tok(tb_tok, b), tb, bb, "ins") if tb is not None else None
            rows.append(("chg", a if ta is not None else None, ha, b if tb is not None else None, hb))
            if ta is not None: a += 1
            if tb is not None: b += 1
    return rows

def datei_html(n, d, wurzel, basis, bis):
    name = d["neu"] if d["alt"] == d["neu"] else f'{d["alt"]} → {d["neu"]}'
    kopf = (f'<summary><span class="st st-{d["status"]}">{d["status"]}</span> '
            f'<b>{html.escape(name)}</b> <span class="p">+{d["plus"]}</span> '
            f'<span class="m">−{d["minus"]}</span></summary>')
    auf = f'<details open class="datei" id="d{n}">{kopf}'
    if d["binaer"]:
        return f'{auf}<div class="leer">Binärdatei</div></details>'
    if not d["hunks"]:
        return f'{auf}<div class="leer">keine Inhaltsänderung</div></details>'
    alt_text = git(wurzel, "show", f"{basis}:{d['alt']}", check=False) if d["status"] != "neu" else ""
    neu_text = git(wurzel, "show", f"{bis}:{d['neu']}", check=False) if d["status"] != "gelöscht" else ""
    ta_tok = zeilen_tokens(alt_text, d["alt"])
    tb_tok = zeilen_tokens(neu_text, d["neu"])
    sbs, inl = [], []
    for h in d["hunks"]:
        hk = html.escape(f'@@ -{h["a"]} +{h["b"]} @@ {h["kopf"]}')
        sbs.append(f'<tr class="hk"><td></td><td colspan="3">{hk}</td></tr>')
        inl.append(f'<tr class="hk"><td></td><td></td><td>{hk}</td></tr>')
        rows = hunk_zeilen(h, ta_tok, tb_tok)
        weg, dazu = [], []
        def leeren():
            for na, x in weg: inl.append(f'<tr><td class="n">{na}</td><td class="n"></td><td class="c weg">{x}</td></tr>')
            for nb, x in dazu: inl.append(f'<tr><td class="n"></td><td class="n">{nb}</td><td class="c dazu">{x}</td></tr>')
            weg.clear(); dazu.clear()
        for typ, na, ha, nb, hb in rows:
            if typ == "ctx":
                sbs.append(f'<tr><td class="n">{na}</td><td class="c">{ha}</td><td class="n">{nb}</td><td class="c">{hb}</td></tr>')
                leeren()
                inl.append(f'<tr><td class="n">{na}</td><td class="n">{nb}</td><td class="c">{hb}</td></tr>')
                continue
            la = f'<td class="n">{na}</td><td class="c weg">{ha}</td>' if ha is not None else '<td class="n"></td><td class="c nix"></td>'
            lb = f'<td class="n">{nb}</td><td class="c dazu">{hb}</td>' if hb is not None else '<td class="n"></td><td class="c nix"></td>'
            sbs.append(f"<tr>{la}{lb}</tr>")
            if ha is not None: weg.append((na, ha))
            if hb is not None: dazu.append((nb, hb))
        leeren()
    cs = '<colgroup><col class="cn"><col><col class="cn"><col></colgroup>'
    ci = '<colgroup><col class="cn"><col class="cn"><col></colgroup>'
    return (f'{auf}<table class="sbs">{cs}{"".join(sbs)}</table>'
            f'<table class="inl">{ci}{"".join(inl)}</table></details>')

