JS = """
const ds=[...document.querySelectorAll('.datei')],ls=[...document.querySelectorAll('#liste a')],kopf=document.getElementById('kopf');
function kh(){document.documentElement.style.setProperty('--kopfh',kopf.offsetHeight+'px')}
kh();addEventListener('resize',kh);document.getElementById('commits').addEventListener('toggle',kh);
function aktuell(){const g=kopf.offsetHeight+20;let k=0;ds.forEach((d,j)=>{if(d.getBoundingClientRect().top<=g)k=j});return k}
function markiere(){const k=aktuell();ls.forEach((a,j)=>a.classList.toggle('akt',j===k));const a=ls[k];if(a){const r=a.getBoundingClientRect(),p=a.parentElement.getBoundingClientRect();if(r.top<p.top||r.bottom>p.bottom)a.scrollIntoView({block:'nearest'})}}
addEventListener('scroll',markiere,{passive:true});markiere();
function geh(k){if(!ds.length)return;k=Math.max(0,Math.min(ds.length-1,k));ds[k].open=true;ds[k].scrollIntoView({block:'start'})}
document.addEventListener('keydown',e=>{if(e.ctrlKey||e.altKey||e.metaKey||/INPUT|TEXTAREA/.test(e.target.tagName))return;
 const k=aktuell();
 if(e.key==='j')geh(ds[k]&&ds[k].getBoundingClientRect().top>kopf.offsetHeight+30?k:k+1);
 else if(e.key==='k')geh(ds[k]&&ds[k].getBoundingClientRect().top<kopf.offsetHeight-5?k:k-1);
 else if(e.key==='i'){document.body.classList.toggle('inline');try{localStorage.mrInline=document.body.classList.contains('inline')?1:''}catch(_){}}
 else if(e.key==='z'){const zu=ds.some(d=>d.open);ds.forEach(d=>d.open=!zu)}
 else if(e.key==='c'){const c=document.getElementById('commits');c.open=!c.open}});
try{if(localStorage.mrInline)document.body.classList.add('inline')}catch(_){}
"""

def main():
    ap = argparse.ArgumentParser(description="Merge-Request-Ansicht reviewed ← claude")
    ap.add_argument("ordner", nargs="?", default=".")
    ap.add_argument("--von", default="reviewed")
    ap.add_argument("--bis", default="claude")
    ap.add_argument("--meld", action="store_true", help="Meld-Ordnervergleich statt Browser")
    ap.add_argument("--inline", action="store_true", help="inline statt nebeneinander starten")
    ap.add_argument("--nur-datei", action="store_true", help="HTML erzeugen, nicht öffnen")
    o = ap.parse_args()
    try:
        wurzel = git(o.ordner, "rev-parse", "--show-toplevel").strip()
        for b in (o.von, o.bis):
            git(wurzel, "rev-parse", "--verify", "-q", b)
        basis = git(wurzel, "merge-base", o.von, o.bis).strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        sys.exit(f"mr: kein Git-Repo oder Branch fehlt ({o.von}/{o.bis}) in {o.ordner}")
    proj_dir = os.path.expanduser("~/Projects/")
    projekt = os.path.relpath(wurzel, proj_dir) if wurzel.startswith(proj_dir) else os.path.basename(wurzel)

    if o.meld:
        subprocess.Popen(["git", "-C", wurzel, "difftool", "--dir-diff", "--tool=meld", "--no-prompt",
                          f"{o.von}...{o.bis}"], start_new_session=True)
        return

    roh = git(wurzel, "log", "--reverse", "--format=%h%x1f%ad%x1f%s%x1f%b%x1e",
              "--date=format:%d.%m. %H:%M", f"{o.von}..{o.bis}")
    commits = [c.strip("\n").split("\x1f") for c in roh.split("\x1e") if c.strip()]
    diff = git(wurzel, "diff", "--find-renames", "-U4", "--no-color", basis, o.bis)
    dateien = zerlegen(diff)
    plus = sum(d["plus"] for d in dateien); minus = sum(d["minus"] for d in dateien)
    todos = sorted(set(re.findall(r"todo:([\w.-]+)", roh)))

    def nachricht(b):
        b = re.sub(r"\n*Co-Authored-By:.*", "", b, flags=re.I).strip()
        return f'<div class="nachricht">{html.escape(b)}</div>' if b else ""
    cl = "".join(f'<div class="commit"><code>{html.escape(h)}</code> <b>{html.escape(s)}</b> '
                 f'<span class="sub">{html.escape(t)}</span>{nachricht(b)}</div>'
                 for h, t, s, b in commits) or '<div class="sub">keine Commits</div>'
    td = ('<div class="todos">todos: ' + "".join(f"<code>{html.escape(t)}</code>" for t in todos) + "</div>"
          if todos else "")
    fl, letzter = [], None
    for n, d in enumerate(dateien):
        ordner, name = os.path.split(d["neu"])
        if ordner != letzter:
            fl.append(f'<div class="sub" style="padding:6px 10px 0">{html.escape(ordner or "/")}</div>'); letzter = ordner
        fl.append(f'<a href="#d{n}" title="{html.escape(d["neu"])}"><span class="zahl"><span class="p">+{d["plus"]}</span> '
                  f'<span class="m">−{d["minus"]}</span></span>{html.escape(name)}'
                  f'{" <span class=sub>(" + d["status"] + ")</span>" if d["status"] != "geändert" else ""}</a>')
    leer = '<div class="leer">Keine Unterschiede – reviewed ist auf dem Stand von claude.</div>' if not dateien else ""
    seite = f"""<!doctype html><html lang="de"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><title>MR {html.escape(projekt)}</title>
<style>{CSS}</style></head><body class="{'inline' if o.inline else ''}">
<header id="kopf"><h1>{html.escape(projekt)}: {html.escape(o.von)} ← {html.escape(o.bis)}</h1>
<span class="sub">{len(commits)} Commit(s) · {len(dateien)} Datei(en) · <span class="p">+{plus}</span> <span class="m">−{minus}</span> · erzeugt {datetime.now():%d.%m.%Y %H:%M}</span>
<details id="commits" open><summary>Commits</summary><div class="liste">{cl}</div>{td}</details></header>
<div class="rahmen"><nav id="liste"><h2>Dateien ({len(dateien)})</h2>{"".join(fl)}</nav>
<main>{leer}{"".join(datei_html(n, d, wurzel, basis, o.bis) for n, d in enumerate(dateien))}</main></div>
<div class="hilfe">j/k Datei · i inline · z zu/auf · c Commits</div>
<script>{JS}</script></body></html>"""
    ziel_dir = os.path.expanduser("~/.cache/mr")
    os.makedirs(ziel_dir, exist_ok=True)
    ziel = os.path.join(ziel_dir, projekt.replace("/", "_") + ".html")
    with open(ziel, "w") as f:
        f.write(seite)
    print(ziel)
    if not o.nur_datei:
        subprocess.Popen(["xdg-open", ziel], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

if __name__ == "__main__":
    main()
