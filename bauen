#!/usr/bin/env python3
"""Baut merge-train aus src/ zusammen.

  ./bauen            src/ (__main__.py, Paket merge_train/ samt web/) zu einer ausführbaren Datei bündeln → ./merge-train
  ./bauen --pruefen  nur vergleichen: Exit 1, wenn ./merge-train nicht zum Stand in src/ passt
  ./bauen --ziel P   nach P bauen statt ./merge-train (Tests: der laufende Server des Nutzers bleibt unberührt)

Das Ergebnis ist ein Python-Zip (zipapp): eine Datei, die python3 direkt startet. Ohne Bauen läuft auch `python3 src`.
Die gebaute Datei ist nicht eingecheckt (.gitignore). ~/.local/bin/merge-train zeigt darauf; die Git-Hooks
aus install.idem.sh bauen nach pull/checkout/rebase neu. Geschrieben wird nur bei einer Änderung (der Server startet bei neuer mtime neu).
"""
import io, os, sys, zipfile

HIER = os.path.dirname(os.path.realpath(__file__))
SRC = os.path.join(HIER, "src")
ZIEL = os.path.join(HIER, "merge-train")
if "--ziel" in sys.argv:
    ZIEL = os.path.abspath(sys.argv[sys.argv.index("--ziel") + 1])


def bauen():
    pfade = []
    for ordner, unterordner, dateien in os.walk(SRC):
        unterordner[:] = sorted(u for u in unterordner if u != "__pycache__")
        pfade += [os.path.join(ordner, d) for d in sorted(dateien)]
    puffer = io.BytesIO()
    with zipfile.ZipFile(puffer, "w", zipfile.ZIP_DEFLATED) as z:
        for pfad in pfade:  # feste Zeit und Reihenfolge: gleicher Stand in src/ ergibt dieselbe Datei
            eintrag = zipfile.ZipInfo(os.path.relpath(pfad, SRC).replace(os.sep, "/"), (1980, 1, 1, 0, 0, 0))
            eintrag.compress_type = zipfile.ZIP_DEFLATED
            eintrag.external_attr = 0o644 << 16
            z.writestr(eintrag, open(pfad, "rb").read())
    return b"#!/usr/bin/env python3\n" + puffer.getvalue()


def main():
    neu = bauen()
    try:
        alt = open(ZIEL, "rb").read()
    except FileNotFoundError:
        alt = None
    if "--pruefen" in sys.argv:
        if alt != neu:
            sys.exit("merge-train passt nicht zu src/ – ./bauen ausführen")
        return
    if alt == neu:
        print("merge-train ist aktuell")
        return
    os.makedirs(os.path.dirname(ZIEL), exist_ok=True)
    tmp = ZIEL + ".neu"
    with open(tmp, "wb") as f:
        f.write(neu)
    os.chmod(tmp, 0o755)
    os.replace(tmp, ZIEL)
    print(f"merge-train gebaut ({len(neu) // 1024} kB)")


if __name__ == "__main__":
    main()
